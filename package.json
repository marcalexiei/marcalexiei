{
  "name": "marcalexiei",
  "version": "1.0.0",
  "private": true,
  "description": "Github profile page",
  "homepage": "https://github.com/marcalexiei/marcalexiei#readme",
  "bugs": {
    "url": "https://github.com/marcalexiei/marcalexiei/issues"
  },
  "license": "MIT",
  "author": "Marco Pasqualetti @marcalexiei",
  "repository": {
    "type": "git",
    "url": "https://github.com/marcalexiei/marcalexiei.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "markdownlint --ignore-path .gitignore \"**/*.md\"",
    "lint:fix": "pnpm run lint --fix",
    "spellcheck": "cspell . --show-context",
    "check-all": "pnpm run \"/^(lint|format:check|spellcheck)$/\""
  },
  "devDependencies": {
    "@marcalexiei/oxfmt-config": "2.0.0",
    "cspell": "10.3.3",
    "lefthook": "2.1.14",
    "markdownlint": "0.41.1",
    "markdownlint-cli": "0.49.1",
    "oxfmt": "0.68.0"
  },
  "engines": {
    "node": ">= 24"
  },
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f"
}
