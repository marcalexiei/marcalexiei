{
  "name": "marcalexiei",
  "version": "1.0.0",
  "private": true,
  "description": "Github profile page",
  "homepage": "https://github.com/marcalexiei/marcalexiei#readme",
  "bugs": {
    "url": "https://github.com/marcalexiei/marcalexiei/issues"
  },
  "license": "MIT",
  "author": "Marco Pasqualetti @marcalexiei",
  "repository": {
    "type": "git",
    "url": "https://github.com/marcalexiei/marcalexiei.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "markdownlint --ignore-path .gitignore \"**/*.md\"",
    "lint:fix": "pnpm run lint --fix",
    "spellcheck": "cspell . --show-context",
    "validate": "pnpm run \"/^(lint|format:check|spellcheck)$/\""
  },
  "devDependencies": {
    "@marcalexiei/oxfmt-config": "2.0.1",
    "cspell": "10.5.2",
    "lefthook": "2.2.1",
    "markdownlint": "0.42.2",
    "markdownlint-cli": "0.50.0",
    "oxfmt": "0.79.0"
  },
  "engines": {
    "node": ">= 24"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
